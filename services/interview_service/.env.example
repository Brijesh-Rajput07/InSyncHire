# LOCATION: services/interview_service/.env.example

# Copy to .env and fill in real values. NEVER commit .env (Section 10i).

GLOBAL_DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/insynchire_global
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- MUST match Auth Service's values EXACTLY -- this service only
# VERIFIES tokens Auth Service issued, it never issues its own ---
JWT_PRIVATE_KEY_PATH=../auth_service/jwt_private.pem
JWT_PUBLIC_KEY_PATH=../auth_service/jwt_public.pem
TOKEN_PAYLOAD_ENCRYPTION_KEY=LwCruCMlURmmZSGo0dEf3ycDaMCTe73qN2-VSHryWNc=

# --- MUST match Migration Service's value EXACTLY (lets this service
# decrypt tenant connection strings Migration Service encrypted) ---
CONNECTION_STRING_ENCRYPTION_KEY=4qkfaIU0qCGwcqOXaYn40XEPJXyAVY6uL43Uczj9QLs=

# --- Room token encryption (Section 5: interview_sessions.room_token
# (encrypted)) -- a DEDICATED key, deliberately not the same key as
# CONNECTION_STRING_ENCRYPTION_KEY (see interview_service/crypto.py's
# module docstring for why). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ROOM_TOKEN_ENCRYPTION_KEY=Yt7cN2sQmX0kLdRz8pWfA1uHjV5eBiT4oGnMqCsUzE8=

# --- M9: how long a WebSocket connect token stays valid after join
# (Section 10e: "short-lived signed token in connection URL") ---
WS_CONNECT_TOKEN_TTL_SECONDS=300