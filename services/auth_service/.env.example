# LOCATION: services/auth_service/.env.example

# Copy to .env and fill in real values. NEVER commit .env (Section 10i).

# --- Databases ---
GLOBAL_DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/insynchire_global
# USERS_DB_DSN / USERS_DB_DSN_SYNC are NOT used by the running service
# (FIX-M2) -- only needed if you're manually running the reference
# alembic_users_db/ migration suite kept here for M4. See README.md.
USERS_DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/users_db
USERS_DB_DSN_SYNC=postgresql://postgres:postgres@localhost:5433/users_db

# --- Redis (OTP storage + token denylist) ---
REDIS_URL=redis://localhost:6379/0

# --- OTP policy ---
OTP_LENGTH=6
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=3
OTP_LOCKOUT_SECONDS=900
# DEV/TEST ONLY: prints the plaintext OTP to the server console log so
# you can test signup before the Notification Service (M7) exists to
# actually send emails. Leave false/unset in any real deployment.
OTP_DEBUG_LOG_ENABLED=true

# --- Token / cookie policy ---
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_DOMAIN=
COOKIE_SECURE=true

# --- RS256 JWT keypair ---
# Generate once with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
# Then point at the files (recommended) or paste inline with \n for newlines.
JWT_PRIVATE_KEY_PATH=./jwt_private.pem
JWT_PUBLIC_KEY_PATH=./jwt_public.pem
# JWT_PRIVATE_KEY_PEM=
# JWT_PUBLIC_KEY_PEM=

# --- AES-256 key for encrypting the token payload before signing ---
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_PAYLOAD_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
