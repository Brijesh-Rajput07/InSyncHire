# LOCATION: services/agent_service/.env.example
# Copy to .env and fill in real values. NEVER commit .env (Section 10i).

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
AGENT_SERVICE_KAFKA_GROUP=agent_service

# --- MUST match Migration Service's value EXACTLY -- only needed once persistence
# (agent_decision_logs / agent_guardrail_logs writes via TenantResolver) is wired
# up in a later milestone (M10). Not required for M6's standalone GuardrailService.
CONNECTION_STRING_ENCRYPTION_KEY=4qkfaIU0qCGwcqOXaYn40XEPJXyAVY6uL43Uczj9QLs=
GLOBAL_DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/insynchire_global

# --- Guardrail policy knobs (Section: GUARDRAILS ARCHITECTURE, Layer 1 Rule 1.2) ---
GUARDRAIL_INPUT_LIMIT_CODE_ANALYSIS=50000
GUARDRAIL_INPUT_LIMIT_QUESTION_STRATEGIST=10000
GUARDRAIL_INPUT_LIMIT_REPORT_SYNTHESIS=200000

# --- Layer 5 Rule 5.2: circuit breaker ---
GUARDRAIL_CIRCUIT_BREAKER_MAX_TRIGGERS=5
GUARDRAIL_CIRCUIT_BREAKER_WINDOW_SECONDS=60
GUARDRAIL_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300

# --- Layer 5 Rule 5.4: integrity flag escalation ---
GUARDRAIL_INTEGRITY_ESCALATION_MAX_SIGNALS=5
GUARDRAIL_INTEGRITY_ESCALATION_WINDOW_SECONDS=1800

# --- Output guardrail retry policy (Layer 2 Rule 2.1) ---
GUARDRAIL_OUTPUT_SCHEMA_MAX_RETRIES=2

# DEV/TEST ONLY: logs every guardrail event (including PASSED) to the
# console in addition to publishing agent.guardrail_triggered. Same
# stopgap pattern as OTP_DEBUG_LOG_ENABLED / INVITE_DEBUG_LOG_ENABLED
# until a real log aggregator is wired up.
GUARDRAIL_DEBUG_LOG_ENABLED=true