# LOCATION: services/notification_service/.env.example
# Copy to .env and fill in real values. NEVER commit .env (Section 10i).

GLOBAL_DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/insynchire_global
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
NOTIFICATION_SERVICE_KAFKA_GROUP=notification_service

# --- MUST match Migration Service's value EXACTLY (lets this service
# decrypt tenant connection strings Migration Service encrypted, so it
# can resolve which recruiters/company_admins to notify for
# application.submitted / scorecard.generated -- a READ, not a write;
# see README.md's "DB ownership" note) ---
CONNECTION_STRING_ENCRYPTION_KEY=4qkfaIU0qCGwcqOXaYn40XEPJXyAVY6uL43Uczj9QLs=

# --- Email sending ---
# EMAIL_PROVIDER=sendgrid | console
# "console" (default) logs the email instead of sending it -- same
# dev/test stopgap pattern as OTP_DEBUG_LOG_ENABLED /
# INVITE_DEBUG_LOG_ENABLED. NEVER use "console" in a real deployment.
EMAIL_PROVIDER=console
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=notifications@insynchire.example