# LOCATION: services/user_profile_service/.env.example

# Copy to .env and fill in real values. NEVER commit .env (Section 10i).

# --- insynchire_global (read-only here -- ONLY to check an
# authenticated caller's account_type when deciding if they're allowed
# to hit /profile/* routes; this service never writes global_users) ---
GLOBAL_DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/insynchire_global

# --- users_db (this service is the FIRST and ONLY writer of
# user_profiles/user_resumes as of M4; user_applications_index and
# user_interview_history exist in schema now but are populated by
# Job Service (M5) / Interview Service (M8-M9) once they exist) ---
USERS_DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/users_db

REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
USER_PROFILE_SERVICE_KAFKA_GROUP=user_profile_service

# --- MUST match Auth Service's values EXACTLY (this service only
# VERIFIES tokens Auth Service issued -- it never issues its own) ---
JWT_PRIVATE_KEY_PATH=../auth_service/jwt_private.pem
JWT_PUBLIC_KEY_PATH=../auth_service/jwt_public.pem
TOKEN_PAYLOAD_ENCRYPTION_KEY=LwCruCMlURmmZSGo0dEf3ycDaMCTe73qN2-VSHryWNc=