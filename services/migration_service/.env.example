# LOCATION: services/migration_service/.env.example

# Copy this file to .env and fill in real values for your environment.
# NEVER commit the actual .env file (Section 10i -- secrets via env only).

# --- insynchire_global connection (this service's own control-plane DB) ---
GLOBAL_DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/insynchire_global
# Sync variant, used only by Alembic when migrating insynchire_global itself
GLOBAL_DB_DSN_SYNC=postgresql://postgres:postgres@localhost:5433/insynchire_global

# --- Admin connection used ONLY to run CREATE DATABASE for new tenants ---
# Must be a role with CREATEDB privilege, connected to the `postgres`
# maintenance database (not insynchire_global, not a tenant DB).
POSTGRES_ADMIN_DSN=postgresql://postgres:postgres@localhost:5433/postgres

# --- Per-tenant DSN templates. {db_name} is substituted at runtime. ---
TENANT_DSN_TEMPLATE=postgresql+asyncpg://postgres:postgres@localhost:5433/{db_name}
TENANT_DSN_TEMPLATE_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5433/{db_name}

# --- Kafka (consumed via the insynchire-events package) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MIGRATION_SERVICE_KAFKA_GROUP=migration_service

# --- Connection-string encryption key (Section 10b: encrypted at rest) ---
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_STRING_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
