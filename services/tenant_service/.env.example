# LOCATION: services/tenant_service/.env.example

# Copy to .env and fill in real values. NEVER commit .env (Section 10i).

GLOBAL_DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5433/insynchire_global
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TENANT_SERVICE_KAFKA_GROUP=tenant_service

# --- MUST match Auth Service's values EXACTLY (see shared/auth-tokens/README.md) ---
JWT_PRIVATE_KEY_PATH=../auth_service/jwt_private.pem
JWT_PUBLIC_KEY_PATH=../auth_service/jwt_public.pem
TOKEN_PAYLOAD_ENCRYPTION_KEY=paste-the-SAME-value-as-auth_service/.env-here

# --- MUST match Migration Service's value EXACTLY ---
CONNECTION_STRING_ENCRYPTION_KEY=paste-the-SAME-value-as-migration_service/.env-here

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_DOMAIN=
COOKIE_SECURE=true

INVITE_TTL_SECONDS=604800
# DEV/TEST ONLY: logs the plaintext invite token/link to the console,
# since the Notification Service (M7) doesn't exist yet to email it.
INVITE_DEBUG_LOG_ENABLED=true
